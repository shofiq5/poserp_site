---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Daily Sales Report App for Shops — POS Plan';
const description =
  "See today's sales, dues, and cash position instantly — no spreadsheet exports. POS Plan gives small shop owners a clear daily and monthly view of the business.";
const base = import.meta.env.BASE_URL;
const canonical = `https://erpboss.com${base}/reports`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I see reports for a specific date range?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, reports can be filtered by date so you can check a single day, a week, or a longer range, not just "today."',
      },
    },
    {
      '@type': 'Question',
      name: 'What does "Daily Closing" do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Daily Closing locks a date so its sales and payments can no longer be edited afterward, which keeps the day's numbers reliable once more than one staff member has access to the till.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can I see reports across all my outlets at once?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, if you run multiple outlets you can see combined totals across all of them, or filter down to a single outlet.',
      },
    },
  ],
};

const points = [
  {
    title: 'Daily closing keeps numbers trustworthy',
    text: 'Close the day and that date locks — past sales and payments can\'t be silently edited once more than one person handles the till.',
    icon: 'M9 12l2 2 4-4M12 22c5.5-1.5 8-6 8-11V5l-8-3-8 3v6c0 5 2.5 9.5 8 11z',
  },
  {
    title: 'Dues and installments at a glance',
    text: 'See who owes money and what\'s due today versus overdue — a dashboard tile and sidebar badge keep it visible without a separate report.',
    icon: 'M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zM3 21c0-4 4-6 9-6s9 2 9 6',
  },
  {
    title: 'Cash book',
    text: 'A running log of cash in and out, so the till balance is something you check against the report, not reconstruct from memory.',
    icon: 'M2 7h20v10H2zM2 7l10-4 10 4M9 12a3 3 0 106 0 3 3 0 00-6 0z',
  },
  {
    title: 'Stock & purchase reports',
    text: 'See stock levels and recent supplier purchases alongside sales — spot what needs reordering without a separate tool.',
    icon: 'M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8',
  },
  {
    title: 'Multi-outlet totals',
    text: 'See combined totals across outlets, or drill into a single outlet\'s numbers — same report, either view.',
    icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 9h1M9 13h1M14 9h1M14 13h1M9 21v-4h6v4',
  },
  {
    title: 'Who sees what',
    text: 'Reports respect staff roles: an owner sees everything, a cashier\'s access stays focused on the till.',
    icon: 'M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M11 3a4 4 0 110 8 4 4 0 010-8z',
  },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd]}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Reports</span>
      <h1>Know today's numbers without asking anyone</h1>
      <p class="lede breadcrumb-lede">
        For a lot of small shop owners, "how did today go?" means flipping through a paper
        register or texting a manager. POS Plan answers that the moment you open it.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-3">
        {points.map((p) => (
          <div class="card feature-card">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon}></path>
              </svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h2>Common questions</h2>
      <div class="faq-list">
        {faqJsonLd.mainEntity.map((qa) => (
          <details class="faq-item">
            <summary>{qa.name}</summary>
            <p>{qa.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>See your shop's numbers clearly</h2>
        <p>Reports pull directly from <a href={`${base}/inventory`} style="color:white;text-decoration:underline;">stock</a> and <a href={`${base}/barcode`} style="color:white;text-decoration:underline;">billing</a>.</p>
        <a class="btn btn-primary" href="https://poserpdev.erpboss.com/signup">Start your free trial</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .faq-list { max-width: 44rem; }
</style>
