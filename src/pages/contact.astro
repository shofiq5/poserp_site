---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact — POS Plan';
const description =
  "Questions about POS Plan for your shop? Reach out and we'll help you get set up — no email required to try it first.";
const canonical = 'https://erpboss.com/contact';
---

<Base title={title} description={description} canonical={canonical}>
  <Nav slot="nav" />

  <h1>Talk to us</h1>
  <p>
    Have a question before you sign up, need help getting your shop set up, or already a
    customer and stuck on something? Reach out directly — there's no support ticket queue to
    wait in.
  </p>

  <h2>Get in touch</h2>
  <ul>
    <li>Email: <a href="mailto:hello@erpboss.com">hello@erpboss.com</a></li>
  </ul>

  <h2>Before you sign up</h2>
  <p>
    Most questions about whether POS Plan fits your shop are answered on
    <a href="/features">features</a> and <a href="/pricing">pricing</a> — multi-outlet support,
    installment plans, barcode compatibility, and what happens on a missed payment are all
    covered there. If your question is more specific to your shop, email us and we'll answer
    directly.
  </p>

  <h2>Already a customer</h2>
  <p>
    For account, billing, or data questions on an existing shop, email from the address linked
    to your account where possible — it helps us find your shop faster and answer without back
    and forth.
  </p>

  <p>
    Prefer to just try it? <a href="https://app.erpboss.com/frontend/signup">Start your free
    trial</a> — sign up with your mobile number, no email needed.
  </p>

  <Footer slot="footer" />
</Base>
