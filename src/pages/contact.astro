---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact — ERPBoss';
const description =
  'Get in touch with ERPBoss about POS Plan for retail or AWBix for freight forwarding. Direct replies, no support ticket queue.';
const canonical = 'https://erpboss.com/contact/';
---

<Base title={title} description={description} canonical={canonical}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container center-text">
      <span class="eyebrow">Contact</span>
      <h1>Talk to us</h1>
      <p class="lede breadcrumb-lede center-mx">
        Tell us what you're running and what's not working. We answer directly — there's no
        support ticket queue to wait in.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="card contact-card">
        <div class="icon-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18l-1.5 12H4.5L3 6zM8 10a4 4 0 008 0"></path>
          </svg>
        </div>
        <h3>About POS Plan</h3>
        <p>For retail — billing, stock, dues, reports.</p>
        <p><a href="mailto:hello@erpboss.com">hello@erpboss.com</a></p>
        <p><a href="/pos/contact/">POS support page</a></p>
      </div>

      <div class="card contact-card">
        <div class="icon-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"></path>
          </svg>
        </div>
        <h3>About AWBix</h3>
        <p>For freight — air, sea, courier and airline EDI.</p>
        <p><a href="mailto:hello@awbix.com?subject=AWBIX%20demo%20request">hello@awbix.com</a></p>
        <p><a href="/logistics/">Logistics overview</a></p>
      </div>

      <div class="card contact-card">
        <div class="icon-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path>
          </svg>
        </div>
        <h3>Anything else</h3>
        <p>Partnerships, press, or a question that fits neither product.</p>
        <p><a href="mailto:hello@erpboss.com">hello@erpboss.com</a></p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .center-text { text-align: center; }
  .center-mx { margin-left: auto; margin-right: auto; }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.5rem; }
  .contact-card { text-align: center; }
  .contact-card p { color: var(--muted); font-size: 0.92rem; margin: 0 0 0.5rem; }
  .contact-card p:last-child { margin-bottom: 0; }
  .contact-card .icon-badge { margin: 0 auto 1rem; }
</style>
