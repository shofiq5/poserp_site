---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Barcode POS Billing Software — POS Plan';
const description =
  "Scan to bill, scan to check price, scan to check stock. POS Plan works with any USB or Bluetooth barcode scanner — no special hardware required.";
const canonical = 'https://erpboss.com/barcode';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What kind of barcode scanner works with POS Plan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Any standard USB or Bluetooth barcode scanner that emulates a keyboard works — there is nothing proprietary to buy or configure.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use POS Plan without a barcode scanner?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every product can also be found by name search from the same billing screen, so you can start selling on day one and add a scanner later.',
      },
    },
    {
      '@type': 'Question',
      name: "Can I create barcodes for products that don't have one?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, you can assign your own product codes for loose or repackaged goods and print labels, so everything in your shop is scannable even without a manufacturer barcode.',
      },
    },
  ],
};

const points = [
  {
    title: 'Scan to bill',
    text: 'Scan an item to add it at its set price. Scan again to bump quantity, or switch to search for anything without a code.',
    icon: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z',
  },
  {
    title: 'Scan to check price or stock',
    text: 'A quick scan answers "how much?" or "in stock?" without starting a full sale.',
    icon: 'M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35',
  },
  {
    title: 'Works with what you have',
    text: 'Any USB or Bluetooth keyboard-emulating scanner works — nothing proprietary, no lock-in.',
    icon: 'M4 4h4v16H4zM10 4h1v16h-1zM13 4h2v16h-2zM17 4h1v16h-1zM20 4h1v16h-1z',
  },
  {
    title: 'No scanner yet? Search works',
    text: 'Start selling on day one with name search, and add a scanner later once the shop is running.',
    icon: 'M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h10a2 2 0 012 2v4M13 13l6 6m-6-2a4 4 0 100-8 4 4 0 000 8z',
  },
  {
    title: 'Print your own barcodes',
    text: 'Assign your own codes for loose or repackaged goods and print labels — everything stays scannable.',
    icon: 'M6 3h12M6 21h12M9 3v18M15 3v18M3 8h4M17 8h4M3 16h4M17 16h4',
  },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd]}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Barcode</span>
      <h1>Barcode billing, without buying new hardware</h1>
      <p class="lede breadcrumb-lede">
        A queue at the counter is not the moment to type a product name letter by letter. POS
        Plan supports barcode scanning at every step of billing — add an item, check its price,
        or check stock, all with a single scan.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-2">
        {points.map((p) => (
          <div class="card feature-card">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon}></path>
              </svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h2>Common questions</h2>
      <div class="faq-list">
        {faqJsonLd.mainEntity.map((qa) => (
          <details class="faq-item">
            <summary>{qa.name}</summary>
            <p>{qa.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Speed up your counter today</h2>
        <p>See how scans feed straight into <a href="/reports" style="color:white;text-decoration:underline;">daily reports</a>.</p>
        <a class="btn btn-primary" href="https://app.erpboss.com/frontend/signup">Start your free trial</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .faq-list { max-width: 44rem; }
</style>
