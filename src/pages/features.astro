---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Features — POS Plan';
const description =
  "Everything a small shop needs from a POS: fast billing, barcode scanning, stock tracking, customer dues, installments, multi-outlet support, and daily reports.";
const canonical = 'https://erpboss.com/features';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I need a barcode scanner to use POS Plan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. You can search products by name, and a barcode scanner speeds up billing if you already have one — no special hardware is required to start.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use POS Plan on more than one outlet?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, POS Plan supports multiple outlets under one shop account, with stock and staff tracked per outlet and stock transfers logged between them.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to know accounting to use it?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. POS Plan is built for shop owners, not accountants — daily sales, stock, and customer dues are shown in plain terms, not ledger entries.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can customers pay in installments?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. POS Plan supports installment plans for larger purchases, with a dashboard showing what is due today, what is overdue, and a guided way to take a payment against a plan.',
      },
    },
  ],
};

const features = [
  {
    title: 'Billing',
    text: "Search by name or scan a barcode, take cash, card, or a partial payment on account. Returns pull up the original sale and adjust stock and balance automatically.",
    icon: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z',
    href: null,
  },
  {
    title: 'Inventory & stock',
    text: 'Every sale and purchase updates stock automatically. See what\'s running low, and manage stock across multiple outlets with logged transfers.',
    icon: 'M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8',
    href: '/inventory',
  },
  {
    title: 'Barcode support',
    text: 'Scan to bill, check a price, or check stock. Works with any standard USB or Bluetooth scanner — no proprietary hardware.',
    icon: 'M4 4h4v16H4zM10 4h1v16h-1zM13 4h2v16h-2zM17 4h1v16h-1zM20 4h1v16h-1z',
    href: '/barcode',
  },
  {
    title: 'Daily reports',
    text: 'See sales, dues, and cash position without exporting anything. Daily Closing locks each day so past numbers can\'t be silently edited.',
    icon: 'M4 19V9M10 19V5M16 19v-7M22 19H2',
    href: '/reports',
  },
  {
    title: 'Customers, dues & installments',
    text: 'Track what regular customers owe on credit, and run full installment plans with due/overdue dashboards and waterfall payments.',
    icon: 'M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zM3 21c0-4 4-6 9-6s9 2 9 6',
    href: null,
  },
  {
    title: 'Purchases & suppliers',
    text: 'Record what you buy from suppliers — stock updates the same way it does on a sale, just in reverse.',
    icon: 'M3 3h2l2.4 12.4a2 2 0 002 1.6h8.2a2 2 0 002-1.6L21 8H6',
    href: null,
  },
  {
    title: 'Cash book',
    text: 'A running log of cash in and out, so the till balance is something you can check, not reconstruct.',
    icon: 'M2 7h20v10H2zM2 7l10-4 10 4M9 12a3 3 0 106 0 3 3 0 00-6 0z',
    href: null,
  },
  {
    title: 'Multi-outlet support',
    text: 'Add outlets under one account, assign staff per location, and see combined or per-outlet reports.',
    icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 9h1M9 13h1M14 9h1M14 13h1M9 21v-4h6v4',
    href: null,
  },
  {
    title: 'Roles for your staff',
    text: 'Owner, Manager, Cashier — access scoped to what each role should see and do.',
    icon: 'M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M11 3a4 4 0 110 8 4 4 0 010-8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
    href: null,
  },
  {
    title: 'Repair jobs',
    text: 'Track a repair from intake to handover — what came in, what\'s being done, and what\'s owed on pickup.',
    icon: 'M14.7 6.3a4 4 0 10-5.4 5.4L2 19v3h3l7.3-7.3a4 4 0 005.4-5.4z',
    href: null,
  },
  {
    title: 'Corporate sales',
    text: 'Keep bulk business/reseller sales distinct from everyday retail, without a separate system.',
    icon: 'M3 21h18M6 21V9l6-4 6 4v12M9 9h.01M15 9h.01M9 13h.01M15 13h.01',
    href: null,
  },
  {
    title: 'Multi-tenant, kept separate',
    text: 'Every shop\'s data is isolated from every other shop on the platform — nothing crosses over.',
    icon: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z',
    href: null,
  },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd]}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Everything included</span>
      <h1>Everything a small shop needs. Nothing it doesn't.</h1>
      <p class="lede breadcrumb-lede">
        POS Plan focuses on the handful of things a small retailer actually does every day: sell,
        restock, collect what's owed, and keep track of the money. Every feature below is
        included — there's no higher tier hiding the parts you'd actually need.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-3">
        {features.map((f) => (
          <div class="card feature-card">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={f.icon}></path>
              </svg>
            </div>
            <h3>{f.href ? <a href={f.href}>{f.title}</a> : f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h2>Common questions</h2>
      <div class="faq-list">
        {faqJsonLd.mainEntity.map((qa) => (
          <details class="faq-item">
            <summary>{qa.name}</summary>
            <p>{qa.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Try it with your own products today</h2>
        <p>No email needed — sign up with your mobile number.</p>
        <a class="btn btn-primary" href="https://app.erpboss.com/frontend/signup">Start your free trial</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .faq-list { max-width: 44rem; }
</style>
