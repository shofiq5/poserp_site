---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Features — POS Plan';
const description =
  'Everything a small shop needs from a POS: fast billing, barcode scanning, stock tracking, customer dues, and daily reports. Nothing an enterprise back office needs and you don\'t.';
const canonical = 'https://erpboss.com/features';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I need a barcode scanner to use POS Plan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. You can search products by name, and a barcode scanner speeds up billing if you already have one — no special hardware is required to start.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use POS Plan on more than one outlet?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, POS Plan supports multiple outlets under one shop account, with stock and staff tracked per outlet.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to know accounting to use it?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. POS Plan is built for shop owners, not accountants — daily sales, stock, and customer dues are shown in plain terms.',
      },
    },
  ],
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd]}>
  <Nav slot="nav" />

  <h1>Everything a small shop needs. Nothing it doesn't.</h1>
  <p>
    POS Plan focuses on the handful of things a small retailer actually does every day: sell,
    restock, and keep track of who owes what. Each area below is deliberately simple — see the
    dedicated pages for detail.
  </p>

  <h2>Billing</h2>
  <p>
    Search products by name or scan a barcode, add them to the sale, and take cash, card, or a
    partial payment on account. Built for speed during a queue at the counter.
  </p>

  <h2><a href="/inventory">Inventory &amp; stock</a></h2>
  <p>
    Every sale updates stock automatically. Track quantity per product, get a picture of what's
    running low, and manage stock across multiple outlets if you have more than one shop.
  </p>

  <h2><a href="/barcode">Barcode support</a></h2>
  <p>
    Scan to bill, scan to look up a price, scan to check stock — barcode support is built into
    billing and inventory, not bolted on as an add-on.
  </p>

  <h2><a href="/reports">Daily reports</a></h2>
  <p>
    See today's sales, dues, and cash position without exporting anything. Reports are built for
    a quick end-of-day check, not a finance department.
  </p>

  <h2>Customers &amp; dues</h2>
  <p>
    Keep a simple record of regular customers and what they owe on credit — including
    installment plans for larger purchases sold on payments over time.
  </p>

  <p><a href="https://app.erpboss.com/frontend/signup">Start your free trial</a> — no email needed.</p>

  <Footer slot="footer" />
</Base>
