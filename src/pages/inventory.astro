---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Mobile Shop Inventory Software — POS Plan';
const description =
  "Track stock automatically as you sell. POS Plan updates inventory on every sale and purchase, supports IMEI tracking for mobile shops, and works across multiple outlets.";
const base = import.meta.env.BASE_URL;
const canonical = `https://erpboss.com${base}/inventory`;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does stock update automatically when I make a sale?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every sale reduces stock for the items sold immediately, with no separate stock-adjustment step required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I track individual phones by IMEI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Products can be tracked by individual serial number or IMEI, so you know exactly which unit sold rather than just a total count.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I move stock between two of my outlets?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, stock transfers between outlets are logged the same way a sale is, so nothing goes missing in a handoff between locations.',
      },
    },
  ],
};

const points = [
  {
    title: 'Real-time, not batch',
    text: 'Sell an item and quantity drops immediately. Buy stock in and it\'s added immediately. No nightly sync, no manual "refresh stock" button.',
    icon: 'M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8',
  },
  {
    title: 'IMEI & serial tracking',
    text: 'Selling phones means every unit is unique. Track by IMEI or serial number, not just a generic count — useful for warranty and repair jobs.',
    icon: 'M7 2h10a1 1 0 011 1v18a1 1 0 01-1 1H7a1 1 0 01-1-1V3a1 1 0 011-1zM9 18h6',
  },
  {
    title: 'Low-stock visibility',
    text: 'See what\'s running low before a customer asks for it — no manual stock-take or spreadsheet export needed.',
    icon: 'M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z',
  },
  {
    title: 'Purchases feed stock in',
    text: 'Purchases from suppliers and sales/returns use the same stock ledger — "what\'s on hand" is always a real-time answer.',
    icon: 'M3 3h2l2.4 12.4a2 2 0 002 1.6h8.2a2 2 0 002-1.6L21 8H6',
  },
  {
    title: 'Multiple outlets, one account',
    text: 'Stock is tracked per outlet, with transfers between outlets logged the same way a sale is.',
    icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 9h1M9 13h1M14 9h1M14 13h1M9 21v-4h6v4',
  },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd]}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Inventory</span>
      <h1>Stock tracking that updates itself</h1>
      <p class="lede breadcrumb-lede">
        The most common inventory mistake in a small shop isn't a bad process — it's no process.
        POS Plan ties stock directly to every sale and purchase, automatically, so the number on
        screen matches what's on the shelf.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid grid-2">
        {points.map((p) => (
          <div class="card feature-card">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon}></path>
              </svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h2>Common questions</h2>
      <div class="faq-list">
        {faqJsonLd.mainEntity.map((qa) => (
          <details class="faq-item">
            <summary>{qa.name}</summary>
            <p>{qa.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Know your stock without counting it</h2>
        <p>See how billing and stock work together on <a href={`${base}/barcode`} style="color:white;text-decoration:underline;">barcode</a>.</p>
        <a class="btn btn-primary" href="https://poserpdev.erpboss.com/signup">Start your free trial</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .faq-list { max-width: 44rem; }
</style>
