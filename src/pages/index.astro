---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'POS Plan — Simple POS Software for Small Shops';
const description =
  'POS Plan is a simple point-of-sale app built for small retailers and mobile shops. Sell, track stock, and see daily sales from your phone — $3/month, no email needed to start.';
const canonical = 'https://erpboss.com/';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What kind of shops is POS Plan built for?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'POS Plan started with mobile phone shops in mind, but it works for any small retail counter — general stores, pharmacies, electronics shops, clothing shops — anywhere one or a few people ring up sales and track stock.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need my own hardware to use POS Plan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. POS Plan runs in a web browser on any phone, tablet, or computer you already have. A barcode scanner and receipt printer help but are optional.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does it take to get started?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sign up with your mobile number and a WhatsApp code — no email, no paperwork. Add your first products and you can start billing the same day.',
      },
    },
  ],
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={[faqJsonLd]}>
  <Nav slot="nav" />

  <section class="hero">
    <h1>POS software built for the small shop owner, not the enterprise back office</h1>
    <p class="lede">
      Ring up sales, track stock, and know what you sold today — from a phone, in a busy
      mobile shop or any small retail counter. No accounting degree required.
    </p>
    <a class="cta" href="https://app.erpboss.com/frontend/signup">Start your free trial</a>
    <p class="subnote">$3/month per shop. Sign up with just your mobile number.</p>
  </section>

  <section>
    <h2>Why small shop owners pick POS Plan</h2>
    <ul>
      <li><strong>No email needed.</strong> Sign up and verify with a WhatsApp code sent to your phone.</li>
      <li><strong>Works the way a shop counter works.</strong> Barcode scan, quick search, and a running total — built for speed during a queue.</li>
      <li><strong>Know your stock without counting it.</strong> Every sale updates inventory automatically, across one or many outlets.</li>
      <li><strong>See the day's numbers instantly.</strong> Daily sales, dues, and cash — without exporting anything to a spreadsheet.</li>
      <li><strong>Priced for a small shop's margins.</strong> $3/month, not $30 — because a corner shop's software bill shouldn't compete with rent.</li>
    </ul>
  </section>

  <section>
    <h2>What a day looks like with POS Plan</h2>
    <p>
      A customer walks up. You scan the item or search it by name, the price and running total
      show instantly, and you take cash, card, or split payment — including a partial payment on
      account if it's a regular customer buying on credit. Stock for that item drops by one, no
      separate step required.
    </p>
    <p>
      At close of day, you tap "Daily Closing." That locks the day's sales and payments so
      nothing gets silently edited later — useful the moment more than one person handles the
      till. The next morning, the dashboard shows yesterday's total, what's still owed by
      customers, and what's running low on the shelf.
    </p>
  </section>

  <section>
    <h2>Built for how small retail actually runs</h2>
    <p>
      Most POS software is built for chains with an IT department: multi-currency ledgers,
      approval workflows, modules you'll never touch. POS Plan strips that down to what a mobile
      shop, pharmacy, or general store actually needs day to day: fast billing, accurate stock,
      and a clear picture of who owes what. It runs in the browser on any phone or tablet — no
      register hardware, no installation, no IT visit.
    </p>
    <p>
      If you run more than one outlet, POS Plan tracks stock and staff per location under a
      single account, so you're not paying for or juggling a separate system per shop.
    </p>
  </section>

  <section>
    <h2>Who's behind the counter, and what they can do</h2>
    <p>
      A shop is rarely run by one person alone. POS Plan gives each staff member a role —
      <strong>Owner</strong>, <strong>Manager</strong>, or <strong>Cashier</strong> — so a cashier
      can ring up sales without being able to see profit margins or edit yesterday's closed sales,
      while the owner keeps full visibility and control. No shared login, no guessing who did what.
    </p>
  </section>

  <section>
    <h2>Explore POS Plan</h2>
    <p>
      See the full list on <a href="/features">features</a>, or go straight to a specific area:
      <a href="/inventory">inventory &amp; stock tracking</a>, <a href="/barcode">barcode
      billing</a>, and <a href="/reports">daily sales reports</a>. Ready to see the price?
      Check <a href="/pricing">pricing</a>.
    </p>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero { text-align: center; padding: 2rem 0 3rem; }
  .hero h1 { font-size: 2rem; margin-bottom: 0.75rem; }
  .lede { color: var(--muted); max-width: 40rem; margin: 0 auto 1.5rem; }
  .cta {
    display: inline-block;
    background: var(--accent);
    color: white;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
  }
  .subnote { color: var(--muted); font-size: 0.85rem; margin-top: 0.75rem; }
</style>
