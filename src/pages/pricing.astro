---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Pricing — $3/month POS Software | POS Plan';
const description =
  "POS Plan costs $3 per month, per shop. No setup fee, no per-feature tiers, cancel anytime. Start with a free trial — sign up with just your mobile number.";
const canonical = 'https://erpboss.com/pricing';

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'POS Plan',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '3',
    priceCurrency: 'USD',
    billingIncrement: 'P1M',
    url: 'https://erpboss.com/pricing',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is there a free trial?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Sign up with your mobile number and try POS Plan before you\'re billed — no credit card required to start the trial.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens if I run more than one shop?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pricing is $3/month per shop. If you run one shop with multiple outlets under it, that\'s one account, one price — outlets are not billed separately.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens if I don\'t pay on time?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You keep read access to your data, and get a short grace period after your billing date before new sales and other writes are paused. Payment reactivates full access immediately — your data is never deleted for a late payment.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I cancel anytime?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, there is no contract. You can stop at any time.',
      },
    },
  ],
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={[productJsonLd, faqJsonLd]}>
  <Nav slot="nav" />

  <h1>Simple pricing: $3/month per shop</h1>
  <p>
    One plan, one price, no tiers to compare. Every feature — billing, inventory, barcode
    support, customer dues and installments, purchases, cash book, and reports — is included
    from day one. You won't hit a paywall halfway through setting up your shop.
  </p>

  <div class="price-card">
    <p class="amount">$3<span>/month per shop</span></p>
    <ul>
      <li>Unlimited sales &amp; products</li>
      <li>Multiple outlets supported under one account</li>
      <li>Daily sales, stock &amp; cash reports</li>
      <li>Customer dues &amp; installment tracking</li>
      <li>Purchases, suppliers &amp; returns</li>
      <li>Staff roles: Owner, Manager, Cashier</li>
      <li>WhatsApp OTP signup — no email required</li>
    </ul>
    <a class="cta" href="https://app.erpboss.com/frontend/signup">Start your free trial</a>
  </div>

  <h2>Why so cheap?</h2>
  <p>
    POS Plan is built specifically for small retailers — mobile shops, pharmacies, general
    stores — where a $30–$50/month POS system eats into a week's profit before it's saved a
    single hour. Keeping the feature set focused on what a small shop actually uses, instead of
    building for an enterprise back office, is what makes $3/month possible without cutting
    corners on the essentials.
  </p>

  <h2>What counts as "per shop"</h2>
  <p>
    A shop is one account — one owner, its products, its customers, its staff. If that shop has
    several physical outlets (branches), they're all included under the same $3/month; you're
    not charged per outlet or per staff login. Running two entirely separate shops under
    different names is two accounts, at $3/month each.
  </p>

  <h2>Late payment doesn't mean losing your data</h2>
  <p>
    If a payment is missed, you keep read access to your shop's data through a short grace
    period, after which new sales and other writes pause until payment goes through — nothing
    is ever wiped for a late payment, and full access comes back the moment you pay.
  </p>

  <h2>Cancel anytime</h2>
  <p>
    There's no contract and no cancellation fee. If POS Plan isn't the right fit for your shop,
    you can stop at any time — your data stays yours, not locked in to keep paying for access
    to it.
  </p>

  <p>Not sure it fits your shop yet? See the full <a href="/features">feature list</a>, or read
  about <a href="/inventory">inventory tracking</a> and <a href="/reports">daily reports</a> in
  detail.</p>

  <Footer slot="footer" />
</Base>

<style>
  .price-card {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 2rem;
    max-width: 24rem;
    margin: 1.5rem 0;
  }
  .amount { font-size: 2.5rem; font-weight: 700; margin: 0 0 1rem; }
  .amount span { font-size: 1rem; font-weight: 400; color: var(--muted); }
  .price-card ul { margin: 0 0 1.5rem; padding-left: 1.25rem; }
  .cta {
    display: inline-block;
    background: var(--accent);
    color: white;
    text-decoration: none;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
  }
</style>
