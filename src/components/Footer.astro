---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <p>&copy; {year} POS Plan. All rights reserved.</p>
    <nav class="links">
      <a href="/features">Features</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
      <a href="https://app.erpboss.com/frontend/login">Log in</a>
    </nav>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); margin-top: 2rem; }
  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .links { display: flex; gap: 1rem; }
  .links a { text-decoration: none; color: var(--muted); }
  .links a:hover { color: var(--fg); }
</style>
