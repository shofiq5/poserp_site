---
const SIGNUP_URL = 'https://app.erpboss.com/frontend/signup';
const LOGIN_URL = 'https://app.erpboss.com/frontend/login';

const links = [
  { href: '/features', label: 'Features' },
  { href: '/inventory', label: 'Inventory' },
  { href: '/barcode', label: 'Barcode' },
  { href: '/reports', label: 'Reports' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- CTA -> app.erpboss.com/frontend/signup (see plan_marketing_site.md "Facts": there is no
     rewrite from "/" on the app host, so every link here must include the /frontend prefix). -->
<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand">POS Plan</a>
    <nav class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="cta">
      <a href={LOGIN_URL} class="login">Log in</a>
      <a href={SIGNUP_URL} class="signup">Start free trial</a>
    </div>
  </div>
</header>

<style>
  .nav-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .brand { font-weight: 700; text-decoration: none; }
  .links { display: flex; gap: 1rem; flex: 1; flex-wrap: wrap; }
  .links a { text-decoration: none; color: var(--muted); font-size: 0.9rem; }
  .links a:hover { color: var(--fg); }
  .cta { display: flex; gap: 0.75rem; align-items: center; }
  .login { text-decoration: none; font-size: 0.9rem; }
  .signup {
    text-decoration: none;
    background: var(--accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
