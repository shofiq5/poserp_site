---
const SIGNUP_URL = 'https://poserpdev.erpboss.com/signup';
const LOGIN_URL = 'https://poserpdev.erpboss.com/login';

// Section nav for the POS product pages at /pos/*. The umbrella site uses Nav.astro.
const links = [
  { href: '/pos/features/', label: 'Features' },
  { href: '/pos/inventory/', label: 'Inventory' },
  { href: '/pos/barcode/', label: 'Barcode' },
  { href: '/pos/reports/', label: 'Reports' },
  { href: '/pos/contact/', label: 'Contact' },
];
---

<!-- CTA -> poserpdev.erpboss.com/signup — the app's permanent domain (replaces the earlier
     app.erpboss.com/frontend/* URLs; this host serves the SPA at root, no /frontend prefix). -->
<header class="nav">
  <div class="container nav-inner">
    <a href="/pos/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="4" width="18" height="16" rx="3" fill="currentColor" opacity="0.15"/>
          <path d="M7 9h10M7 13h6M7 17h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <circle cx="17" cy="16.5" r="2.5" fill="currentColor"/>
        </svg>
      </span>
      POS Plan
      <span class="brand-by">by ERPBoss</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/" class="link-up">All ERPBoss products</a>
      <div class="cta cta-mobile">
        <a href={LOGIN_URL} class="btn btn-ghost">Log in</a>
        <a href={SIGNUP_URL} class="btn btn-primary">Start free trial</a>
      </div>
    </nav>

    <div class="cta cta-desktop">
      <a href={LOGIN_URL} class="btn btn-ghost">Log in</a>
      <a href={SIGNUP_URL} class="btn btn-primary">Start free trial</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Lexend', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--fg);
  }
  .brand-mark {
    display: inline-flex;
    color: var(--primary);
  }
  .brand-mark svg { width: 1.9rem; height: 1.9rem; }
  .brand-by {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .link-up { white-space: nowrap; }

  .links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .links a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .links a:hover { color: var(--primary-dark); }

  .cta { display: flex; gap: 0.6rem; align-items: center; }
  .cta-mobile { display: none; }

  .nav-toggle { display: none; }
  .nav-burger { display: none; }

  @media (max-width: 860px) {
    .nav-inner { flex-wrap: wrap; }
    .cta-desktop { display: none; }
    .nav-burger {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-left: auto;
      cursor: pointer;
      padding: 0.4rem;
    }
    .nav-burger span {
      width: 22px;
      height: 2px;
      background: var(--fg);
      border-radius: 2px;
    }
    .links {
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
      width: 100%;
    }
    .nav-toggle:checked ~ .links {
      max-height: 24rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      margin-top: 0.75rem;
    }
    .cta-mobile {
      display: flex;
      flex-wrap: wrap;
      width: 100%;
      padding-bottom: 0.5rem;
    }
    .cta-mobile .btn { flex: 1; }
  }
</style>
