---
const links = [
  { href: '/air-cargo-edi/', label: 'Airline EDI' },
  { href: '/ocean/', label: 'Ocean' },
  { href: '/courier/', label: 'Courier' },
  { href: '/platform/', label: 'Platform' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.7"/>
        </svg>
      </span>
      CargoXY
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu"><span></span><span></span><span></span></label>

    <nav class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="https://erpboss.com/" class="link-up">ERPBoss</a>
      <div class="cta cta-mobile"><a href="/contact/" class="btn btn-primary">Request a demo</a></div>
    </nav>

    <div class="cta cta-desktop"><a href="/contact/" class="btn btn-primary">Request a demo</a></div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; gap: var(--sp-5); padding-block: 0.9rem; }
  .brand {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
    letter-spacing: -0.01em; text-decoration: none; color: var(--fg);
  }
  .brand-mark { display: inline-flex; color: var(--accent); }
  .brand-mark svg { width: 1.6rem; height: 1.6rem; }
  .links { display: flex; align-items: center; gap: var(--sp-5); flex: 1; flex-wrap: wrap; justify-content: flex-end; }
  .links a { text-decoration: none; color: var(--muted); font-size: 0.92rem; font-weight: 500; }
  .links a:hover { color: var(--accent-strong); }
  .link-up { white-space: nowrap; }
  .cta { display: flex; gap: var(--sp-2); }
  .cta-mobile { display: none; }
  .nav-toggle, .nav-burger { display: none; }

  @media (max-width: 900px) {
    .nav-inner { flex-wrap: wrap; }
    .cta-desktop { display: none; }
    .nav-burger { display: flex; flex-direction: column; gap: 4px; margin-left: auto; cursor: pointer; padding: 0.55rem; }
    .nav-burger span { width: 22px; height: 2px; background: var(--fg); border-radius: 2px; }
    .links {
      flex-basis: 100%; flex-direction: column; align-items: flex-start; gap: var(--sp-4);
      width: 100%; max-height: 0; overflow: hidden; transition: max-height var(--dur-2) var(--ease);
    }
    .nav-toggle:checked ~ .links { max-height: 28rem; padding-top: var(--sp-4); border-top: 1px solid var(--border); margin-top: var(--sp-3); }
    .cta-mobile { display: flex; width: 100%; padding-bottom: var(--sp-2); }
    .cta-mobile .btn { flex: 1; }
  }
</style>
