---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'CargoXY — Freight Forwarding Software for Air, Sea and Courier';
const description =
  'CargoXY runs air, sea and courier shipments in one platform, with EDI connectivity to airlines so AWB data is transmitted electronically instead of retyped. Request a demo.';
const canonical = 'https://cargoxy.com/';

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CargoXY',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: canonical,
};

const faqs = [
  { q: 'Does CargoXY handle sea and courier as well as air?', a: 'Yes. Air, ocean and courier consignments run in the same system, sharing customers, rates, billing and accounts rather than sitting in separate tools.' },
  { q: 'What does EDI connectivity actually do?', a: 'It sends AWB and House AWB data to the airline electronically and receives status updates back, so the same shipment is not rekeyed into a carrier portal after it was already entered once.' },
  { q: 'Do we need to replace our accounting system?', a: 'No. CargoXY carries quotations, invoicing and accounts itself, but it is designed to be adopted for freight operations first.' },
  { q: 'How is CargoXY sold?', a: 'By demo rather than self-serve signup. Freight operations differ enough that a walkthrough against your own shipments is more useful than a trial account.' },
];

const modes = [
  { t: 'Air', d: 'AWB and House AWB handling, airline EDI, EGM and IGM processing, and the documents that go with them.', i: 'M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20', href: '/air-cargo-edi/' },
  { t: 'Ocean', d: 'FCL and LCL shipments with bills of lading produced from the job record rather than retyped into a template.', i: 'M2 20s2-1 4-1 3 1 6 1 4-1 6-1 4 1 4 1M4 18l1-6h14l1 6M8 12V7h8v5', href: '/ocean/' },
  { t: 'Courier', d: 'Consignments, labels and tracking for the door-to-door work that sits alongside your freight business.', i: 'M3 3h2l2.4 12.4a2 2 0 002 1.6h8.2a2 2 0 002-1.6L21 8H6', href: '/courier/' },
];

const value = [
  { t: 'Your data arrives before your cargo', d: 'Electronic messaging gets shipment data to the carrier ahead of the freight, which is what keeps acceptance from being held up at the counter.', i: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z' },
  { t: 'The retyping stops', d: 'Capture a shipment once and it flows into the manifest, the documents and the invoice. Most data-entry errors are simply not possible any more.', i: 'M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11' },
  { t: 'One set of numbers', d: 'The job, the invoice and the ledger read the same records, so a billing dispute is settled by looking rather than reconstructing.', i: 'M2 7h20v10H2zM9 12a3 3 0 106 0 3 3 0 00-6 0z' },
  { t: 'Built for a working desk', d: 'Designed around what a forwarder does all day, not around a configuration screen you need a consultant to fill in.', i: 'M4 4h16v12H4zM2 20h20' },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={[appJsonLd, {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}]}>
  <Nav slot="nav" />

  <section class="hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Freight forwarding software</span>
      <h1 data-reveal>One system. Every shipment. Zero retyping.</h1>
      <p class="lede lede-wide" data-reveal>
        Retyping a shipment into an airline portal is where delays and billing disputes begin:
        a digit changes, acceptance is held up, and the invoice no longer matches what flew.
        CargoXY captures each consignment once and transmits it — by air, sea or courier.
      </p>
      <div class="btn-row" style="margin-top: var(--sp-5)" data-reveal>
        <a class="btn btn-primary" href="/contact/">Request a demo</a>
        <a class="btn btn-ghost" href="/air-cargo-edi/">How airline EDI works</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {modes.map((m) => (
          <a class="card card-hover mode-card" href={m.href} data-reveal>
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={m.i}></path></svg>
            </div>
            <h2>{m.t}</h2>
            <p>{m.d}</p>
            <span class="more">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow" data-reveal>Why it matters</span>
      <h2 data-reveal>What changes when the data moves electronically</h2>
      <div class="grid grid-2" style="margin-top: var(--sp-6)">
        {value.map((v) => (
          <div class="card card-hover feature-card" data-reveal>
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={v.i}></path></svg>
            </div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow" data-reveal>FAQ</span>
      <h2 data-reveal>Common questions</h2>
      <div class="faq-list" style="margin-top: var(--sp-5)" data-reveal>
        {faqs.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner" data-reveal>
        <h2>See it against your own shipments</h2>
        <p>A walkthrough on your routes and your paperwork tells you more in twenty minutes than a trial account will in a week.</p>
        <div class="btn-row"><a class="btn btn-primary" href="/contact/">Request a demo</a></div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero { padding-block: var(--sp-8) var(--sp-6); }
  .hero h1 { max-width: 18ch; margin-bottom: var(--sp-5); }
  .mode-card { text-decoration: none; display: flex; flex-direction: column; }
  .mode-card h2 { font-size: var(--step-2); margin-bottom: var(--sp-2); }
  .mode-card p { color: var(--muted); font-size: var(--step--1); flex: 1; }
  .more { margin-top: var(--sp-4); font-size: var(--step--1); font-weight: 600; color: var(--accent-strong); }
</style>
