---
import { modules } from '../data/erp.js';
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-5h6v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      ERPBoss
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="links">
      <a href="/pos/">POS</a>
      {modules.slice(0, 4).map((m) => <a href={`/erp/${m.slug}/`}>{m.nav}</a>)}
      <a href="/#modules" class="link-up">All modules</a>
      <div class="cta cta-mobile">
        <a href="/contact/" class="btn btn-primary">Request a demo</a>
      </div>
    </nav>

    <div class="cta cta-desktop">
      <a href="/contact/" class="btn btn-primary">Request a demo</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .nav.is-scrolled { box-shadow: var(--shadow-sm); border-color: transparent; }
  .nav-inner { display: flex; align-items: center; gap: var(--sp-5); padding-block: 0.9rem; }
  .brand {
    display: inline-flex; align-items: center; gap: var(--sp-2);
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
    text-decoration: none; color: var(--fg); white-space: nowrap;
  }
  .brand-mark { display: inline-flex; color: var(--accent); }
  .brand-mark svg { width: 1.7rem; height: 1.7rem; }
  .brand-by { font-family: var(--font-body); font-weight: 500; font-size: 0.72rem; color: var(--muted); }
  .links {
    display: flex; align-items: center; gap: var(--sp-5);
    flex: 1; flex-wrap: wrap; justify-content: flex-end;
  }
  .links a { text-decoration: none; color: var(--muted); font-size: 0.9rem; font-weight: 500; }
  .links a:hover { color: var(--accent-strong); }
  .link-up { white-space: nowrap; }
  .cta { display: flex; gap: var(--sp-2); align-items: center; }
  .cta-mobile { display: none; }
  .nav-toggle, .nav-burger { display: none; }

  @media (max-width: 980px) {
    .nav-inner { flex-wrap: wrap; }
    .cta-desktop { display: none; }
    .nav-burger {
      display: flex; flex-direction: column; gap: 4px;
      margin-left: auto; cursor: pointer; padding: 0.55rem;
    }
    .nav-burger span { width: 22px; height: 2px; background: var(--fg); border-radius: 2px; }
    .links {
      flex-basis: 100%; flex-direction: column; align-items: flex-start;
      gap: var(--sp-4); width: 100%;
      max-height: 0; overflow: hidden; transition: max-height var(--dur-2) var(--ease);
    }
    .nav-toggle:checked ~ .links {
      max-height: 32rem; padding-top: var(--sp-4);
      border-top: 1px solid var(--border); margin-top: var(--sp-3);
    }
    .cta-mobile { display: flex; width: 100%; padding-bottom: var(--sp-2); }
    .cta-mobile .btn { flex: 1; }
  }
</style>

<script>
  const nav = document.querySelector('.nav');
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
