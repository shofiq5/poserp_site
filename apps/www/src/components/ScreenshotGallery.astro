---
/* Real product screenshots, framed like the .device mocks used
   elsewhere on the site. Images live in /public/screenshots/ using
   the filenames below — Astro serves anything in /public as-is, so
   no build step is needed once the files land. Until then the frame
   shows a placeholder rather than a broken image. */
export interface Shot {
  src: string;
  alt: string;
  title: string;
  caption: string;
}

const { shots }: { shots?: Shot[] } = Astro.props;

const defaultShots: Shot[] = [
  {
    src: '/screenshots/sales.jpeg',
    alt: 'ERPBoss Sales screen showing total sales, cash sales, installment sales and due sales for a shop',
    title: 'Sales',
    caption: 'Every invoice — cash, installment or due — in one running total.',
  },
  {
    src: '/screenshots/installments.jpeg',
    alt: 'ERPBoss Installments screen showing scheduled collections on credit sales',
    title: 'Installments',
    caption: 'Scheduled collections tracked per customer, with the next due date front and centre.',
  },
  {
    src: '/screenshots/stock.jpeg',
    alt: 'ERPBoss Stock screen showing product list, stock value and low-stock alerts',
    title: 'Stock',
    caption: 'Stock value and low-stock alerts, live from the same ledger that sales post to.',
  },
];

const list = shots?.length ? shots : defaultShots;
---

<div class="shot-grid">
  {list.map((s) => (
    <figure class="shot-card" data-reveal>
      <div class="device shot-device">
        <div class="device-bar"><span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span></div>
        <div class="shot-frame">
          <img
            src={s.src}
            alt={s.alt}
            loading="lazy"
            decoding="async"
            class="shot-img"
            onerror="this.closest('.shot-frame').classList.add('shot-frame--empty')"
          />
          <div class="shot-placeholder" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 15l4.5-4.5 3 3L17 7l4 4"/></svg>
            <span>Screenshot coming soon</span>
          </div>
        </div>
      </div>
      <figcaption>
        <strong>{s.title}</strong>
        <p>{s.caption}</p>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .shot-grid {
    display: grid;
    gap: var(--sp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .shot-card { display: flex; flex-direction: column; gap: var(--sp-3); }
  .shot-device { background: var(--surface-2); }
  .shot-frame {
    position: relative;
    aspect-ratio: 9 / 16;
    max-height: 34rem;
    background: var(--bg-alt);
  }
  .shot-img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .shot-frame .shot-placeholder { display: none; }
  .shot-frame--empty .shot-img { display: none; }
  .shot-frame--empty .shot-placeholder {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--sp-3); color: var(--muted); font-size: var(--step--1); text-align: center; padding: var(--sp-5);
  }
  .shot-frame--empty .shot-placeholder svg { width: 2.2rem; height: 2.2rem; opacity: 0.6; }
  .shot-card figcaption strong { display: block; font-family: var(--font-display); font-size: var(--step-0); margin-bottom: 0.2rem; }
  .shot-card figcaption p { margin: 0; color: var(--muted); font-size: var(--step--1); }
</style>
