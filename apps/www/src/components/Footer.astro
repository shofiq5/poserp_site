---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-cols">
      <div class="footer-brand">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="3" width="8" height="8" rx="2" fill="currentColor"/>
              <rect x="13" y="3" width="8" height="8" rx="2" fill="currentColor" opacity="0.45"/>
              <rect x="3" y="13" width="8" height="8" rx="2" fill="currentColor" opacity="0.45"/>
              <rect x="13" y="13" width="8" height="8" rx="2" fill="currentColor"/>
            </svg>
          </span>
          ERPBoss
        </a>
        <p>One business system built from modules — point of sale, accounts, stock, people and more — for the people who run the operation.</p>
      </div>

      <div>
        <h4>Modules</h4>
        <ul>
          <li><a href="/#modules">All modules</a></li>
          <li><a href="/erp/accounting/">Accounting</a></li>
          <li><a href="/erp/inventory/">Inventory</a></li>
          <li><a href="/erp/manufacturing/">Manufacturing</a></li>
          <li><a href="/erp/sales-crm/">Sales &amp; CRM</a></li>
          <li><a href="/erp/payroll/">Payroll</a></li>
        </ul>
      </div>

      <div>
        <h4>ERPBoss POS</h4>
        <ul>
          <li><a href="/pos/">Overview</a></li>
          <li><a href="/pos/features/">Features</a></li>
          <li><a href="/pos/inventory/">Inventory</a></li>
          <li><a href="/pos/barcode/">Barcode billing</a></li>
          <li><a href="/pos/reports/">Reports</a></li>
        </ul>
      </div>

      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="https://pos.erpboss.com/login">POS log in</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} ERPBoss. All rights reserved.</p>
      <ul class="footer-legal">
        <li><a href="/contact/">Privacy</a></li>
        <li><a href="/contact/">Terms</a></li>
        <li><a href="/contact/">Security</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    margin-top: 2rem;
  }
  .footer-inner { padding: 3rem 1.5rem 2rem; }
  .footer-cols {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Lexend', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--fg);
    margin-bottom: 0.75rem;
  }
  .footer-brand .brand-mark { color: var(--accent); display: inline-flex; }
  .footer-brand .brand-mark svg { width: 1.5rem; height: 1.5rem; }
  .footer-brand p { color: var(--muted); font-size: 0.9rem; max-width: 22rem; margin: 0; }

  h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg);
    margin: 0 0 0.9rem;
  }
  .footer ul { list-style: none; padding: 0; margin: 0; }
  .footer li { margin-bottom: 0.6rem; }
  .footer a { text-decoration: none; color: var(--muted); font-size: 0.9rem; }
  .footer a:hover { color: var(--accent-strong); }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .footer-bottom p { margin: 0; }
  .footer-legal { display: flex; gap: 1.25rem; list-style: none; padding: 0; margin: 0; }
  .footer-legal li { margin: 0; }
  .footer-legal a { text-decoration: none; color: var(--muted); font-size: 0.82rem; }
  .footer-legal a:hover { color: var(--accent-strong); }

  @media (max-width: 860px) {
    .footer-cols { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
