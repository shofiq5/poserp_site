---
/* Landing-page launch panel: the one place a visitor can go straight
   into the live POS app. Themed POS blue regardless of page theme. */
const SIGNUP = 'https://pos.erpboss.com/signup';
const LOGIN = 'https://pos.erpboss.com/login';
---
<section class="launch" data-theme="pos" aria-labelledby="launch-title">
  <div class="container">
    <div class="launch-card" data-reveal>
      <div class="launch-copy">
        <span class="live-pill"><span class="live-dot" aria-hidden="true"></span>Live now · ERPBoss POS</span>
        <h2 id="launch-title">Open your shop's till in under two minutes</h2>
        <p>
          ERPBoss POS is live and works on its own. Sign up with your mobile number, add a product, and ring up your first
          sale today — on the phone already in your pocket.
        </p>

        <div class="launch-actions">
          <a class="btn btn-primary btn-lg" href={SIGNUP}>
            Start free trial
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a class="btn btn-ghost btn-lg" href={LOGIN}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
            Log in
          </a>
        </div>

        <ul class="launch-trust">
          <li>No credit card</li>
          <li>No email needed</li>
          <li>Works on any phone</li>
        </ul>
      </div>

      <div class="launch-visual" aria-hidden="true">
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="screen">
            <div class="screen-head">
              <span>Today's sale</span>
              <span class="screen-badge">#1024</span>
            </div>
            <ul class="lines">
              <li style="--i:0"><span>Phone case</span><b>৳ 450</b></li>
              <li style="--i:1"><span>Screen protector</span><b>৳ 250</b></li>
              <li style="--i:2"><span>USB-C cable</span><b>৳ 350</b></li>
            </ul>
            <div class="total"><span>Total</span><b>৳ 1,050</b></div>
            <div class="pay">Paid · Cash</div>
          </div>
        </div>
        <div class="float-chip chip-a">✓ Stock updated</div>
        <div class="float-chip chip-b">+ Sale recorded</div>
      </div>
    </div>
  </div>
</section>

<style>
  .launch { padding-block: var(--sp-5) var(--sp-6); }

  .launch-card {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--sp-6);
    align-items: center;
    padding: clamp(1.75rem, 1rem + 3vw, 3.25rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent) 0%, transparent 60%),
      linear-gradient(180deg, var(--surface), var(--surface-2));
    box-shadow: var(--shadow-lg);
    isolation: isolate;
    overflow: hidden;
  }
  /* animated gradient border */
  .launch-card::before {
    content: '';
    position: absolute; inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(from var(--angle, 0deg),
      var(--accent), color-mix(in srgb, var(--accent) 15%, transparent) 30%,
      transparent 50%, color-mix(in srgb, var(--accent) 15%, transparent) 70%, var(--accent));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: spin 6s linear infinite;
    z-index: -1;
  }
  @property --angle { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --angle: 360deg; } }

  .live-pill {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, #16a34a 12%, transparent);
    color: #15803d;
    font-size: var(--step--1); font-weight: 700; letter-spacing: 0.02em;
    margin-bottom: var(--sp-4);
  }
  .live-dot {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse { to { box-shadow: 0 0 0 0.6rem rgb(34 197 94 / 0); } }

  .launch-copy h2 { font-size: var(--step-3); max-width: 18ch; margin-bottom: var(--sp-3); }
  .launch-copy p { color: var(--muted); max-width: 46ch; font-size: var(--step-0); }

  .launch-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-5); }
  .btn-lg { min-height: 52px; padding: 0.85rem 1.6rem; font-size: var(--step-0); }
  .btn-lg svg { width: 1.1rem; height: 1.1rem; }
  .btn-primary svg { transition: transform var(--dur-2) var(--ease); }
  .btn-primary:hover svg { transform: translateX(3px); }

  .launch-trust {
    display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-5);
    list-style: none; padding: 0; margin-top: var(--sp-4);
    font-size: var(--step--1); color: var(--muted);
  }
  .launch-trust li { margin: 0; display: inline-flex; align-items: center; gap: 0.4rem; }
  .launch-trust li::before { content: '✓'; color: var(--accent); font-weight: 700; }

  /* phone mock */
  .launch-visual { position: relative; display: grid; place-items: center; min-height: 20rem; }
  .phone {
    width: min(15rem, 100%);
    padding: 0.7rem;
    border-radius: 2.2rem;
    background: #0b1220;
    box-shadow: 0 30px 60px -25px rgb(11 18 32 / 0.55);
    transform: rotate(-4deg);
    animation: float 6s var(--ease) infinite;
  }
  @keyframes float { 50% { transform: rotate(-4deg) translateY(-8px); } }
  .phone-notch { width: 35%; height: 0.9rem; margin: 0 auto 0.5rem; border-radius: 999px; background: #1e293b; }
  .screen { background: #fff; color: #0b1220; border-radius: 1.6rem; padding: 1rem; font-size: 0.78rem; }
  .screen-head {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; margin-bottom: 0.7rem;
  }
  .screen-badge { font-size: 0.65rem; background: #eff6ff; color: #1d4ed8; padding: 0.15rem 0.45rem; border-radius: 999px; }
  .lines { list-style: none; padding: 0; margin: 0; }
  .lines li {
    display: flex; justify-content: space-between; margin: 0;
    padding: 0.45rem 0; border-bottom: 1px dashed #e2e8f0;
    opacity: 0; animation: add 0.5s var(--ease) forwards;
    animation-delay: calc(0.6s + var(--i) * 0.45s);
  }
  @keyframes add { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
  .total { display: flex; justify-content: space-between; margin-top: 0.7rem; font-family: var(--font-display); font-size: 1rem; }
  .pay {
    margin-top: 0.7rem; text-align: center; padding: 0.5rem; border-radius: 0.7rem;
    background: #2563eb; color: #fff; font-weight: 600;
  }
  .float-chip {
    position: absolute;
    padding: 0.4rem 0.75rem; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border);
    box-shadow: var(--shadow); font-size: 0.75rem; font-weight: 600; color: var(--fg);
    white-space: nowrap;
  }
  .chip-a { top: 12%; left: 0; animation: float 5s var(--ease) infinite; }
  .chip-b { bottom: 14%; right: 0; animation: float 5.5s var(--ease) 1s infinite; }

  @media (max-width: 860px) {
    .launch-card { grid-template-columns: 1fr; text-align: left; }
    .launch-visual { min-height: 17rem; }
    .launch-actions .btn { flex: 1 1 12rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .launch-card::before, .live-dot, .phone, .float-chip { animation: none; }
    .lines li { opacity: 1; animation: none; }
  }
</style>
