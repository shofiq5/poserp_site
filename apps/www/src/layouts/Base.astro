---
/* erpboss.com wrapper around the shared shell — injects the company's
   Organization data so individual pages don't have to. */
import UiBase from '@erpboss/ui/Base.astro';

const { title, description, canonical, theme, jsonLd = [] } = Astro.props;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ERPBoss',
  url: 'https://erpboss.com/',
  logo: 'https://erpboss.com/favicon.svg',
  sameAs: [],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: 'https://erpboss.com/contact/',
  },
};
---
<UiBase
  title={title}
  description={description}
  canonical={canonical}
  theme={theme}
  siteName="ERPBoss"
  jsonLd={[orgJsonLd, ...jsonLd]}
>
  <slot name="nav" slot="nav" />
  <slot />
  <slot name="footer" slot="footer" />
</UiBase>
