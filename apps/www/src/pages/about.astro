---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'About — ERPBoss';
const description =
  'ERPBoss builds operational software for small teams: POS Plan for retail counters and AWBix for freight forwarders. Built on Frappe, sold without an implementation project.';
const canonical = 'https://erpboss.com/about/';
---

<Base title={title} description={description} canonical={canonical}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>We build the system, not the implementation project</h1>
      <p class="lede breadcrumb-lede">
        ERPBoss makes software for small operating teams — a shop with two staff on the counter,
        a forwarder with a handful of people booking cargo. Both are usually offered the same
        two bad options: enterprise software that needs a consultant, or a spreadsheet that
        needs a person.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>What we make</h2>
      <div class="grid grid-2">
        <div class="card feature-card">
          <h3><a href="/pos/">POS Plan</a></h3>
          <p>
            Point-of-sale for small retailers — mobile shops, pharmacies, general stores.
            Billing, stock, customer dues and daily reports, running in a browser on whatever
            phone or tablet is already at the counter.
          </p>
        </div>
        <div class="card feature-card">
          <h3><a href="/logistics/">AWBix</a></h3>
          <p>
            Freight software for forwarders handling air, sea and courier shipments, including
            EDI connectivity to airlines so shipment data is transmitted rather than retyped.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How we build</h2>
      <p class="section-lede breadcrumb-lede">
        Both products sit on <strong>Frappe</strong>, an open-source application framework, which
        is why two systems this different can share the same foundations for accounts, roles,
        permissions and reporting. It also means neither product is a black box: the data model
        is inspectable and your records are exportable.
      </p>
      <p class="section-lede breadcrumb-lede">
        We keep the feature set deliberately narrow. Every addition has to earn its place for a
        team that has no administrator, no IT department, and no appetite for a rollout. When
        something is genuinely complex — airline messaging, multi-outlet stock — we take on that
        complexity so the person at the desk doesn't have to.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Want to know if we're a fit?</h2>
        <p>We'd rather tell you no early than sell you a system you'll fight with.</p>
        <a class="btn btn-primary" href="/contact/">Talk to us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
