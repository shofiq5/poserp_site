---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'About — ERPBoss';
const description =
  'ERPBoss is a business system for small teams, built from independent modules — starting with ERPBoss POS for retail counters. Built on Frappe, sold without an implementation project.';
const canonical = 'https://erpboss.com/about/';
---

<Base title={title} description={description} canonical={canonical}>
  <Nav slot="nav" />

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>We build the system, not the implementation project</h1>
      <p class="lede breadcrumb-lede">
        ERPBoss makes software for small operating teams — a shop with two staff on the counter,
        a company that has outgrown its accounts package. Both are usually offered the same
        two bad options: enterprise software that needs a consultant, or a spreadsheet that
        needs a person.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>What we make</h2>
      <div class="grid grid-2">
        <div class="card card-hover feature-card">
          <h3><a href="/pos/">ERPBoss POS</a></h3>
          <p>
            Point-of-sale for small retailers — mobile shops, pharmacies, general stores.
            Billing, stock, customer dues and daily reports, running in a browser on whatever
            phone or tablet is already at the counter. Works on its own.
          </p>
        </div>
        <div class="card card-hover feature-card">
          <h3><a href="/#modules">The rest of the system</a></h3>
          <p>
            Accounting, inventory, purchasing, sales, manufacturing, HR, payroll, projects and
            more — modules that share one set of records, set up for your company.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How we build</h2>
      <p class="section-lede breadcrumb-lede">
        ERPBoss sits on <strong>Frappe</strong>, an open-source application framework, which
        is why every module can share the same foundations for accounts, roles, permissions and
        reporting. It also means the system is not a black box: the data model is inspectable
        and your records are exportable.
      </p>
      <p class="section-lede breadcrumb-lede">
        We keep the feature set deliberately narrow. Every addition has to earn its place for a
        team that has no administrator, no IT department, and no appetite for a rollout. When
        something is genuinely complex — multi-outlet stock, double-entry postings — we take on that
        complexity so the person at the desk doesn't have to.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Want to know if we're a fit?</h2>
        <p>We'd rather tell you no early than sell you a system you'll fight with.</p>
        <a class="btn btn-primary" href="/contact/">Talk to us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
