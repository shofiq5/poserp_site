---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'ERPBoss — ERP, POS and Logistics Software for Growing Businesses';
const description =
  'ERPBoss builds three systems for SMEs: a full ERP, a point-of-sale for retail counters, and CargoXY for air, sea and courier freight. Pick the one that fits your operation.';
const canonical = 'https://erpboss.com/';

const products = [
  {
    name: 'ERP Boss',
    tag: 'ERP',
    href: '/erp/',
    theme: 'erp',
    line: 'Run the whole business on one ledger',
    blurb:
      'Accounting, inventory, manufacturing, sales, purchasing, HR and projects in a single system — deployed for your company, not shared with anyone else.',
    points: ['Double-entry accounting, multi-currency', 'Stock, warehouses and valuation', 'Manufacturing, CRM, HR and projects'],
    cta: 'Explore ERP Boss',
    icon: 'M3 21h18M5 21V8l7-5 7 5v13M9 21v-5h6v5M9 11h1M14 11h1',
  },
  {
    name: 'POSERP',
    tag: 'Point of sale',
    href: '/pos/',
    theme: 'pos',
    line: 'The counter, handled',
    blurb:
      'Ring up sales, track stock and see the day’s numbers from a phone. Built for shops that have no IT department and no time for one.',
    points: ['Barcode billing and fast search', 'Stock that updates on every sale', 'Customer dues and installments'],
    cta: 'Explore POSERP',
    icon: 'M3 6h18l-1.5 12H4.5L3 6zM8 10a4 4 0 008 0',
  },
  {
    name: 'CargoXY',
    tag: 'Logistics',
    href: '/logistics/',
    theme: 'cargo',
    line: 'Every shipment, no retyping',
    blurb:
      'Air, sea and courier freight in one platform, with EDI connectivity to airlines so shipment data is transmitted rather than rekeyed at every handoff.',
    points: ['Airline EDI: AWB and House AWB data', 'EGM & IGM processing', 'Quotations, billing and accounts'],
    cta: 'Explore CargoXY',
    icon: 'M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20M4 7h16M4 17h16',
  },
];

const principles = [
  {
    title: 'Built to be used, not configured',
    text: 'Sensible defaults on day one. You should be working in it the week you start, not scoping an implementation.',
    icon: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z',
  },
  {
    title: 'Your data stays yours',
    text: 'Isolated per account, exportable on request, and never held hostage to keep you paying for access to it.',
    icon: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z',
  },
  {
    title: 'Roles, not shared logins',
    text: 'Owners, managers and staff each see what they should. No shared passwords, no guessing who changed what.',
    icon: 'M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M11 3a4 4 0 110 8 4 4 0 010-8z',
  },
  {
    title: 'One platform underneath',
    text: 'All three share the same foundations for accounts, permissions and reporting — which is why a small team can maintain them properly.',
    icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  },
];
---

<Base title={title} description={description} canonical={canonical}>
  <Nav slot="nav" />

  <section class="hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Three products, one company</span>
      <h1 data-reveal>Software for the people who actually run the operation</h1>
      <p class="lede lede-wide" data-reveal>
        A factory floor, a shop counter and a freight desk look nothing alike — but they share a
        problem. The software built for them is either made for enterprises they will never
        resemble, or it is a spreadsheet. We build for the gap in between.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="product-grid">
        {products.map((p) => (
          <article class="card card-hover product-card" data-theme={p.theme} data-reveal>
            <div class="product-head">
              <div class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.icon}></path>
                </svg>
              </div>
              <span class="tag">{p.tag}</span>
            </div>
            <h2>{p.name}</h2>
            <p class="product-line">{p.line}</p>
            <p class="product-blurb">{p.blurb}</p>
            <ul class="checklist product-points">
              {p.points.map((pt) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
            <a class="btn btn-primary" href={p.href}>{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow" data-reveal>How we build</span>
      <h2 data-reveal>The same four commitments across all three</h2>
      <p class="section-lede" data-reveal>
        Different industries, identical discipline. These are the rules we hold each product to.
      </p>
      <div class="grid grid-2" style="margin-top: var(--sp-6)">
        {principles.map((p) => (
          <div class="card card-hover feature-card" data-reveal>
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon}></path>
              </svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner" data-reveal>
        <h2>Not sure which one fits?</h2>
        <p>Tell us what you run and we will point you at the right product — or tell you plainly if none of them is a fit.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Talk to us</a>
          <a class="btn btn-ghost" href="/about/">About ERPBoss</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero { padding-block: var(--sp-8) var(--sp-6); }
  .hero h1 { max-width: 20ch; margin-bottom: var(--sp-5); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: var(--sp-5);
  }
  .product-card { display: flex; flex-direction: column; }
  .product-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-4);
  }
  .product-card h2 { font-size: var(--step-2); margin-bottom: var(--sp-1); }
  .product-line {
    color: var(--accent-strong); font-weight: 600; font-size: var(--step--1);
    margin-bottom: var(--sp-3);
  }
  .product-blurb { color: var(--muted); font-size: var(--step--1); }
  .product-points { margin: var(--sp-4) 0 var(--sp-5); flex: 1; }
  .product-card .btn { align-self: flex-start; }
</style>
