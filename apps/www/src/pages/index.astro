---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'ERPBoss — Business Software for Retail and Logistics';
const description =
  'ERPBoss builds two products: POS Plan, a simple point-of-sale for small retailers, and AWBix, a freight system for air, sea and courier operations with airline EDI connectivity.';
const canonical = 'https://erpboss.com/';

const products = [
  {
    name: 'POS Plan',
    tag: 'Retail',
    href: '/pos/',
    blurb:
      'A simple point-of-sale for small shops. Ring up sales, track stock, and see the day\'s numbers from a phone — no accounting degree required.',
    points: ['Barcode billing & fast search', 'Stock that updates on every sale', 'Customer dues & installments', 'Daily sales, cash and stock reports'],
    cta: 'Explore POS Plan',
    icon: 'M3 6h18l-1.5 12H4.5L3 6zM8 10a4 4 0 008 0',
  },
  {
    name: 'AWBix',
    tag: 'Logistics',
    href: '/logistics/',
    blurb:
      'A freight platform for forwarders running air, sea and courier shipments — with EDI connectivity to airlines so shipment data stops being retyped.',
    points: ['Airline EDI: AWB & House AWB data', 'EGM & IGM processing', 'Air, ocean and courier jobs', 'Quotations, billing and accounts'],
    cta: 'Explore AWBix',
    icon: 'M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20M4 7h16M4 17h16',
  },
];
---

<Base title={title} description={description} canonical={canonical}>
  <Nav slot="nav" />

  <section class="hero">
    <div class="container">
      <span class="eyebrow">Two products, one company</span>
      <h1>Software for the people who actually run the operation</h1>
      <p class="lede">
        ERPBoss builds working software for two very different desks — the retail counter and
        the freight office. Both are built on the same idea: the person doing the job should be
        able to run the system without a consultant.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="product-grid">
        {products.map((p) => (
          <article class="card product-card">
            <div class="product-head">
              <div class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.icon}></path>
                </svg>
              </div>
              <span class="product-tag">{p.tag}</span>
            </div>
            <h2>{p.name}</h2>
            <p class="product-blurb">{p.blurb}</p>
            <ul class="product-points">
              {p.points.map((pt) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                  {pt}
                </li>
              ))}
            </ul>
            <a class="btn btn-primary" href={p.href}>{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Why both</span>
      <h2>A shop counter and a freight desk have the same problem</h2>
      <p class="section-lede breadcrumb-lede">
        Both are run by small teams under time pressure, and both are usually served either by
        software built for enterprises they'll never resemble, or by a spreadsheet. We build for
        the gap in between: systems that hold real operational detail without needing a
        dedicated administrator to keep them running.
      </p>

      <div class="grid grid-3">
        <div class="card feature-card">
          <div class="icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"></path>
            </svg>
          </div>
          <h3>Built to be used, not configured</h3>
          <p>Sensible defaults out of the box. You should be working in it the day you sign up, not scoping an implementation.</p>
        </div>
        <div class="card feature-card">
          <div class="icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path>
            </svg>
          </div>
          <h3>Your data stays yours</h3>
          <p>Every account's data is isolated, exportable, and never held hostage to keep you paying for access to it.</p>
        </div>
        <div class="card feature-card">
          <div class="icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M11 3a4 4 0 110 8 4 4 0 010-8z"></path>
            </svg>
          </div>
          <h3>Roles, not logins</h3>
          <p>Owners, managers and staff each see what they should. No shared passwords, no guessing who changed what.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h2>Not sure which one fits?</h2>
        <p>Tell us what you're running and we'll point you at the right product — or tell you if neither is a fit.</p>
        <a class="btn btn-primary" href="/contact/">Talk to us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero { padding: 3.5rem 0 1.5rem; }
  .hero .lede { max-width: 44rem; font-size: 1.05rem; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .product-card { display: flex; flex-direction: column; }
  .product-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .product-head .icon-badge { margin-bottom: 0.75rem; }
  .product-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary-dark);
    background: var(--primary-light);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }
  .product-card h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .product-blurb { color: var(--muted); font-size: 0.95rem; }
  .product-points { list-style: none; padding: 0; margin: 0 0 1.5rem; flex: 1; }
  .product-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.92rem;
    margin-bottom: 0.55rem;
  }
  .product-points svg {
    width: 1rem;
    height: 1rem;
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 0.3rem;
  }
  .product-card .btn { align-self: flex-start; }
</style>
