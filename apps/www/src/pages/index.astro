---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PosLaunch from '../components/PosLaunch.astro';
import AccountsMock from '../components/AccountsMock.astro';
import { modules } from '../data/erp.js';

const title = 'ERPBoss — Modular ERP and POS Software for Growing Businesses';
const description =
  'ERPBoss is one business system built from modules: point of sale, accounting, inventory, purchasing, sales, manufacturing, HR, payroll and more. Start with ERPBoss POS today and add modules as you grow.';
const canonical = 'https://erpboss.com/';

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ERPBoss',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: canonical,
};

const principles = [
  {
    title: 'Built to be used, not configured',
    text: 'Sensible defaults on day one. You should be working in it the week you start, not scoping an implementation.',
    icon: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z',
  },
  {
    title: 'Your data stays yours',
    text: 'Isolated per account, exportable on request, and never held hostage to keep you paying for access to it.',
    icon: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z',
  },
  {
    title: 'Roles, not shared logins',
    text: 'Owners, managers and staff each see what they should. No shared passwords, no guessing who changed what.',
    icon: 'M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M11 3a4 4 0 110 8 4 4 0 010-8z',
  },
  {
    title: 'One platform underneath',
    text: 'Every module shares the same foundations for accounts, permissions and reporting — which is why a small team can maintain them properly.',
    icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  },
];
---

<Base title={title} description={description} canonical={canonical} theme="erp" jsonLd={[appJsonLd]}>
  <Nav slot="nav" />

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow" data-reveal>ERPBoss</span>
        <h1 data-reveal>One business system, built from modules</h1>
        <p class="lede" data-reveal>
          Most growing companies end up with a till, an accounts package and a stock spreadsheet
          that agree with each other only by luck. ERPBoss replaces them with modules that share
          one set of records. Start with the one you need, and add the rest as the business grows.
        </p>
        <div class="btn-row" style="margin-top: var(--sp-5)" data-reveal>
          <a class="btn btn-primary" href="#modules">See the modules</a>
          <a class="btn btn-ghost" href="/contact/">Talk to us</a>
        </div>
        <p class="note" data-reveal>ERPBoss POS works on its own — sign up and start selling today.</p>
      </div>
      <div data-reveal>
        <AccountsMock />
      </div>
    </div>
  </section>

  <PosLaunch />

  <section class="section" id="modules">
    <div class="container">
      <span class="eyebrow" data-reveal>The modules</span>
      <h2 data-reveal>Fourteen modules, one set of records</h2>
      <p class="section-lede" data-reveal>
        Each one is useful on its own. Together they mean a sale moves stock, stock values the
        balance sheet, an asset depreciates on schedule and a project tells you whether it was
        worth taking — without anyone re-entering anything.
      </p>
      <div class="grid grid-3" style="margin-top: var(--sp-6)">
        <a class="card card-hover module-card" href="/pos/" data-reveal>
          <div class="module-head">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18l-1.5 12H4.5L3 6zM8 10a4 4 0 008 0"></path>
              </svg>
            </div>
            <span class="tag">Live · free trial</span>
          </div>
          <h3>POS</h3>
          <p>Ring up sales, track stock and see the day’s numbers from a phone. Works standalone — no other module needed.</p>
          <span class="module-more">Explore ERPBoss POS →</span>
        </a>
        {modules.map((m) => (
          <a class="card card-hover module-card" href={`/erp/${m.slug}/`} data-reveal>
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={m.features[0].i}></path>
              </svg>
            </div>
            <h3>{m.name}</h3>
            <p>{m.tagline}</p>
            <span class="module-more">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow" data-reveal>Why one system</span>
      <h2 data-reveal>The reconciliation problem, removed</h2>
      <div class="grid grid-3" style="margin-top: var(--sp-6)">
        <div class="card feature-card" data-reveal>
          <h3>One event, one entry</h3>
          <p>A sale posts revenue, tax and the cost-of-sales pair together. There is no second system to agree with, so there is nothing to reconcile.</p>
        </div>
        <div class="card feature-card" data-reveal>
          <h3>Start small, grow into it</h3>
          <p>ERPBoss POS is ready the minute you sign up. The wider system runs as your company's own instance — which is what makes customisation and data ownership straightforward.</p>
        </div>
        <div class="card feature-card" data-reveal>
          <h3>Reports without exports</h3>
          <p>Statements read the same postings your daily work creates, so a report is a view of the business rather than a monthly assembly job.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow" data-reveal>How we build</span>
      <h2 data-reveal>Four commitments behind every module</h2>
      <p class="section-lede" data-reveal>
        These are the rules we hold each module to.
      </p>
      <div class="grid grid-2" style="margin-top: var(--sp-6)">
        {principles.map((p) => (
          <div class="card card-hover feature-card" data-reveal>
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon}></path>
              </svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner" data-reveal>
        <h2>See it running on your kind of business</h2>
        <p>Tell us what you make or sell, and we will show you the modules that fit rather than a generic tour.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Request a demo</a>
          <a class="btn btn-ghost" href="/pos/">Start with POS</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero { padding-block: var(--sp-8) var(--sp-6); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--sp-7);
    align-items: center;
  }
  .note { color: var(--muted); font-size: var(--step--1); margin-top: var(--sp-4); }
  .module-card { text-decoration: none; display: flex; flex-direction: column; }
  .module-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-4);
  }
  .module-card h3 { margin-bottom: var(--sp-2); }
  .module-card p { color: var(--muted); font-size: var(--step--1); flex: 1; }
  .module-more {
    margin-top: var(--sp-4);
    font-size: var(--step--1); font-weight: 600; color: var(--accent-strong);
  }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
