---
import Base from '../../layouts/Base.astro';
import ErpNav from '../../components/ErpNav.astro';
import Footer from '../../components/Footer.astro';
import AccountsMock from '../../components/AccountsMock.astro';
import { modules } from '../../data/erp.js';

const title = 'ERP Boss — ERP Software for Growing Businesses';
const description =
  'A full ERP for SMEs: double-entry accounting, inventory, manufacturing, sales and CRM, purchasing, HR and payroll, and projects — deployed for your company.';
const canonical = 'https://erpboss.com/erp/';

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ERP Boss',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: canonical,
};
---

<Base title={title} description={description} canonical={canonical} theme="erp" jsonLd={[appJsonLd]}>
  <ErpNav slot="nav" />

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow" data-reveal>ERP Boss</span>
        <h1 data-reveal>Run the whole business on one ledger</h1>
        <p class="lede" data-reveal>
          Most growing companies end up with an accounts package, a stock spreadsheet and a
          folder of quotations that agree with each other only by luck. ERP Boss puts all of it
          on one set of records, so the numbers reconcile because they were never separate.
        </p>
        <div class="btn-row" style="margin-top: var(--sp-5)" data-reveal>
          <a class="btn btn-primary" href="/contact/">Request a demo</a>
          <a class="btn btn-ghost" href="#modules">See the modules</a>
        </div>
        <p class="note" data-reveal>Deployed for your company — your own instance, your own data.</p>
      </div>
      <div data-reveal>
        <AccountsMock />
      </div>
    </div>
  </section>

  <section class="section" id="modules">
    <div class="container">
      <span class="eyebrow" data-reveal>The system</span>
      <h2 data-reveal>Twelve modules, one set of records</h2>
      <p class="section-lede" data-reveal>
        Each one is useful on its own. Together they mean a sale moves stock, stock values the
        balance sheet, an asset depreciates on schedule and a project tells you whether it was
        worth taking — without anyone re-entering anything.
      </p>
      <div class="grid grid-3" style="margin-top: var(--sp-6)">
        {modules.map((m) => (
          <a class="card card-hover module-card" href={`/erp/${m.slug}/`} data-reveal>
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={m.features[0].i}></path>
              </svg>
            </div>
            <h3>{m.name}</h3>
            <p>{m.tagline}</p>
            <span class="module-more">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow" data-reveal>Why one system</span>
      <h2 data-reveal>The reconciliation problem, removed</h2>
      <div class="grid grid-3" style="margin-top: var(--sp-6)">
        <div class="card feature-card" data-reveal>
          <h3>One event, one entry</h3>
          <p>A sale posts revenue, tax and the cost-of-sales pair together. There is no second system to agree with, so there is nothing to reconcile.</p>
        </div>
        <div class="card feature-card" data-reveal>
          <h3>Your own deployment</h3>
          <p>ERP Boss runs as your company's own instance rather than a shared tenancy — which is what makes customisation and data ownership straightforward.</p>
        </div>
        <div class="card feature-card" data-reveal>
          <h3>Reports without exports</h3>
          <p>Statements read the same postings your daily work creates, so a report is a view of the business rather than a monthly assembly job.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner" data-reveal>
        <h2>See it running on your kind of business</h2>
        <p>Tell us what you make, sell or move, and we will show you the setup that fits rather than a generic tour.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Request a demo</a>
          <a class="btn btn-ghost" href="/">Other ERPBoss products</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero { padding-block: var(--sp-8) var(--sp-6); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--sp-7);
    align-items: center;
  }
  .note { color: var(--muted); font-size: var(--step--1); margin-top: var(--sp-4); }
  .module-card { text-decoration: none; display: flex; flex-direction: column; }
  .module-card h3 { margin-bottom: var(--sp-2); }
  .module-card p { color: var(--muted); font-size: var(--step--1); flex: 1; }
  .module-more {
    margin-top: var(--sp-4);
    font-size: var(--step--1); font-weight: 600; color: var(--accent-strong);
  }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
